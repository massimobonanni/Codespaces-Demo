{
    "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
	"remoteEnv": {
    	"MY_API_KEY": "${localEnv:MY_API_KEY}"
  	},
    "features": {
		"ghcr.io/azure/azure-dev/azd:latest": {},
        "ghcr.io/frntn/devcontainers-features/postman:1": {},
        "ghcr.io/devcontainers/features/azure-cli:1": {
			"version": "latest",
			"bicepVersion": "latest"
		},
		"ghcr.io/jlaundry/devcontainer-features/azure-functions-core-tools:1": {
			"version": "latest"
		}
    },
    "postCreateCommand": "bash -lc 'if [ -z \"$MY_API_KEY\" ]; then echo \"Missing MY_API_KEY\"; else echo \"Secret available\"; fi'; echo '👋 Welcome to Default Codespace Config!'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-azurefunctions",
                "humao.rest-client"
            ]
        }
    }
}
